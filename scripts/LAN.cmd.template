@echo off
setlocal EnableExtensions
set "ROOT=%~dp0"
set "APP_DIR=%ROOT%app"
set "LOG_DIR=%ROOT%logs"
set "NODE_EXE=%ROOT%runtime\node.exe"
set "PORT=3000"
set "SHARE_LAN=1"

if not "%~1"=="" (
  echo [ERROR] LAN.cmd does not accept options.
  exit /b 1
)

if not exist "%LOG_DIR%" mkdir "%LOG_DIR%" || goto :mkdir_failed

if not exist "%NODE_EXE%" (
  echo [ERROR] Missing packaged Node runtime: "%NODE_EXE%"
  echo Rebuild the portable ZIP; do not copy only the launcher.
  exit /b 1
)

if not exist "%APP_DIR%\server.js" (
  echo [ERROR] Missing app server: "%APP_DIR%\server.js"
  echo Rebuild the portable ZIP; do not copy only the launcher.
  exit /b 1
)

netstat -ano -p tcp | findstr /r /c:":%PORT% .*LISTENING" >nul
if not errorlevel 1 (
  echo [ERROR] Port %PORT% is already in use. Close the other local process, then run LAN.cmd again.
  exit /b 1
)

echo Starting The Player in LAN shared mode.
echo The host browser will open automatically. Use Copy room link in the app to share with LAN devices.
echo Logs: "%LOG_DIR%\server.log"
> "%LOG_DIR%\server.log" echo Server log started.
for /f %%P in ('powershell -NoProfile -Command "$process = Start-Process -FilePath $env:NODE_EXE -ArgumentList @($env:APP_DIR + '\server.js') -WindowStyle Hidden -RedirectStandardOutput ($env:LOG_DIR + '\server.log') -RedirectStandardError ($env:LOG_DIR + '\server-error.log') -PassThru; $process.Id"') do set "SERVER_PID=%%P"
if not defined SERVER_PID (
  echo [ERROR] Could not start the packaged Node server. See "%LOG_DIR%\server.log".
  exit /b 1
)

powershell -NoProfile -Command "$deadline = (Get-Date).AddSeconds(30); while ((Get-Date) -lt $deadline) { try { Invoke-WebRequest -UseBasicParsing -Uri 'http://127.0.0.1:%PORT%/' -TimeoutSec 2 | Out-Null; exit 0 } catch { Start-Sleep -Milliseconds 500 } }; exit 1"
if errorlevel 1 (
  echo [ERROR] Server did not become ready within 30 seconds. See "%LOG_DIR%\server.log".
  call :stop_server
  exit /b 1
)

set "HOST_URL="
for /f "usebackq delims=" %%A in (`powershell -NoProfile -Command "$deadline = (Get-Date).AddSeconds(30); while ((Get-Date) -lt $deadline) { if (Test-Path ($env:LOG_DIR + '\server.log')) { $match = Select-String -Path ($env:LOG_DIR + '\server.log') -Pattern '^Host library URL: (http://\S+\?token=[A-Za-z0-9_-]+)$' | Select-Object -First 1; if ($match) { [Console]::WriteLine($match.Matches[0].Groups[1].Value); exit 0 } }; Start-Sleep -Milliseconds 500 }; exit 1"`) do if not defined HOST_URL set "HOST_URL=%%A"
if not defined HOST_URL (
  echo [ERROR] LAN sharing started but no tokenized host URL appeared within 30 seconds. See "%LOG_DIR%\server.log".
  call :stop_server
  exit /b 1
)
if not "%THE_PLAYER_NO_OPEN%"=="1" start "" "%HOST_URL%"
exit /b 0

:stop_server
if defined SERVER_PID powershell -NoProfile -Command "$process = Get-Process -Id %SERVER_PID% -ErrorAction SilentlyContinue; if ($process -and $process.Path -eq $env:NODE_EXE) { Stop-Process -Id $process.Id }"
exit /b 0

:mkdir_failed
echo [ERROR] Could not create portable log directory beside LAN.cmd.
exit /b 1
